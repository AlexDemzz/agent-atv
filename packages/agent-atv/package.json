{
  "name": "agent-atv",
  "version": "0.2.2",
  "description": "A CLI that lets AI agents observe and drive an Apple TV (snapshot, press, open, type, wait, screenshot).",
  "license": "MIT",
  "author": "AlexDemzz",
  "homepage": "https://github.com/AlexDemzz/agent-atv#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexDemzz/agent-atv.git",
    "directory": "packages/agent-atv"
  },
  "bugs": {
    "url": "https://github.com/AlexDemzz/agent-atv/issues"
  },
  "keywords": [
    "apple-tv",
    "tvos",
    "cli",
    "ai-agent",
    "claude-code",
    "homebridge"
  ],
  "type": "module",
  "bin": {
    "agent-atv": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint --no-error-on-unmatched-pattern src test",
    "test": "vitest run --maxWorkers=2 --exclude 'test/e2e/**'",
    "test:e2e": "vitest run --maxWorkers=1 test/e2e"
  }
}
